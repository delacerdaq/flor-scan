# Copie este arquivo para ".env" e preencha com a sua chave real.
# ".env" já está no .gitignore — nunca o versione.

# Obtenha gratuitamente em https://my.plantnet.org/signup (até 500 identificações/dia, sem cartão de crédito).
# Depois de criar a conta, gere a chave na área de configurações/API da sua conta em my.plantnet.org.
PLANTNET_API_KEY=

# Porta do proxy de identificação (opcional, padrão: 3333)
IDENTIFICACAO_API_PORT=3333

# Origem do Angular permitida por CORS (opcional, padrão: http://localhost:4200)
ANGULAR_ORIGIN=http://localhost:4200
